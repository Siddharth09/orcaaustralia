# Postgres connection string (Neon free tier recommended: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe webhook signing secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (https://resend.com/api-keys) - for order confirmation emails
RESEND_API_KEY="re_..."
ORDER_EMAIL_FROM="Orca Australia <orders@orcaaustralia.com>"

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) - for product photo uploads
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Admin dashboard
ADMIN_PASSWORD="change-me"
# Random 32+ char secret used to sign the admin session cookie
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for Stripe redirect URLs, email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
